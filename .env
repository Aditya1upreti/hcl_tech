# RAG Document Q&A System - Environment Configuration
# ===================================================
# 
# Copy this file to .env and add your API keys.
# Never commit real API keys to version control.

# === LLM Provider Configuration ===
# Default provider is gemini. Options: gemini | ollama | openai
LLM_PROVIDER=gemini

# Gemini API key - get free at https://aistudio.google.com/
# Get your key from AI Studio and paste it here (no quotes or spaces)
GEMINI_API_KEY=

# Gemini model name - current models from AI Studio:
# gemini-1.5-flash, gemini-1.5-flash-8b, gemini-1.0-pro, etc.
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API key (optional)
OPENAI_API_KEY=

# OpenAI model name (optional)
OPENAI_MODEL=gpt-3.5-turbo

# Ollama model name (optional, for local Llama model)
# Make sure Ollama is running locally at http://localhost:11434
OLLAMA_MODEL=llama3.2

# === Application Settings ===
# Chunking parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Embedding model (local, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Important Notes ===
# 
# 1. If LLM_PROVIDER=gemini and GEMINI_API_KEY is empty, the system will:
#    a. Fall back to Ollama if running at localhost:11434
#    b. Otherwise enter retrieval-only mode (no generated answers)
#
# 2. The .env file must be loaded with python-dotenv
#   : import os from dotenv import load_dotenv; load_dotenv()
#
# 3. Add .env to .gitignore - never commit real API keys
#
# 4. If model name gives "not found" error, change GEMINI_MODEL to a current
#    model from AI Studio (e.g., gemini-1.5-flash)
#
# 5. For Ollama to work, install and run Olloma locally:
#    - https://ollama.ai/
#    - Pull a model: ollama pull llama3.2